---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import KeyBenefits from "../components/KeyBenefits.astro";
import InteractiveDemo from "../components/InteractiveDemo.astro";
import Features from "../components/Features.astro";
import CloudSync from "../components/CloudSync.astro";
import DownloadSection from "../components/DownloadSection.astro";
import "../styles/global.css";
---

<Layout title="GymTrack v1.1.4 | Gestión de Gimnasios Inteligente — NeuralJira">
	<header class="site-header">
		<a href="#main-content" class="skip-link visually-hidden">Saltar al contenido principal</a>
		<div class="container nav-inner">
			<a href="#" class="brand-logo">
				<span class="brand-dot"></span>
				<span>GymTrack</span>
				<small class="brand-ver">v1.1.4</small>
			</a>
			<nav aria-label="Principal">
				<ul class="nav-list" role="list">
					<li><a href="#features">Módulos</a></li>
					<li><a href="#demo">Demo Interactiva</a></li>
					<li><a href="#cloud">Cloud Sync</a></li>
					<li><a href="#download" class="nav-cta">Descargar Gratis ↓</a></li>
				</ul>
			</nav>
		</div>
	</header>

	<main id="main-content" tabindex="-1">
		<Hero />

		<div class="divider"></div>

		<Features />

		<div class="divider"></div>

		<KeyBenefits />

		<div class="divider"></div>

		<InteractiveDemo />

		<div class="divider"></div>

		<CloudSync />

		<div class="divider"></div>

		<DownloadSection />

		<section id="cta" class="container text-center pt-20">
			<div
				class="glass p-16"
				style="background: linear-gradient(180deg, rgba(249,115,22,.05) 0%, transparent 100%);"
			>
				<h2 class="text-5xl font-bold mb-6">
					¿Listo para transformar tu gimnasio?
				</h2>
				<p class="text-xl text-muted mb-10 max-w-2xl mx-auto">
					Descarga el instalador oficial desde nuestro servidor seguro, activa tu prueba gratuita de 7 días al instante y lleva el control total de tu negocio.
				</p>
				<div class="cta-buttons">
					<a
						href="#download"
						class="btn btn-primary px-12 py-4 text-xl"
					>
						<svg
							aria-hidden="true"
							xmlns="http://www.w3.org/2000/svg"
							width="24"
							height="24"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"
							></path>
							<polyline points="7 10 12 15 17 10"></polyline>
							<line x1="12" y1="15" x2="12" y2="3"></line>
						</svg>
						Ir al Centro de Descargas
					</a>
					<a
						href="mailto:contacto@neuraljira.tech?subject=Informaci%C3%B3n%20Licencia%20GymTrack"
						class="btn glass px-12 py-4 text-xl">Contactar Ventas</a
					>
				</div>
			</div>
		</section>
	</main>

	<footer class="container py-12 text-center text-muted border-t mt-20">
		<p>
			&copy; 2026 GymTrack SaaS · NeuralJira (`server.neuraljira.tech`). La plataforma definitiva para gimnasios modernos.
		</p>
	</footer>
</Layout>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(11, 15, 26, 0.85);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border);
		padding: 0.85rem 0;
	}
	.skip-link:focus {
		position: fixed !important;
		top: 0.75rem;
		left: 0.75rem;
		z-index: 100;
		background: var(--accent);
		color: var(--ink);
		padding: 0.5rem 1rem;
		border-radius: 6px;
		font-weight: 700;
	}
	.nav-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}
	.brand-logo {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: 800;
		font-size: 1.2rem;
		color: var(--white);
	}
	.brand-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 8px var(--accent);
	}
	.brand-ver {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--electric);
		background: rgba(56, 189, 248, 0.12);
		border: 1px solid rgba(56, 189, 248, 0.3);
		padding: 0.1rem 0.45rem;
		border-radius: 4px;
	}
	.nav-list {
		list-style: none;
		display: flex;
		align-items: center;
		gap: 1.5rem;
		margin: 0;
		padding: 0;
		flex-wrap: wrap;
	}
	.nav-list a {
		color: var(--text);
		font-size: 0.9rem;
		font-weight: 600;
	}
	.nav-list a:hover {
		color: var(--accent);
	}
	.nav-cta {
		background: rgba(249, 115, 22, 0.15);
		color: var(--accent) !important;
		border: 1px solid rgba(249, 115, 22, 0.35);
		padding: 0.4rem 0.95rem;
		border-radius: 6px;
	}
	.nav-cta:hover {
		background: var(--accent);
		color: var(--ink) !important;
	}
	.divider {
		height: 1px;
		background: linear-gradient(
			90deg,
			transparent,
			var(--border),
			transparent
		);
		margin: 3rem 0;
	}
	.text-5xl {
		font-size: 3.5rem;
	}
	.text-center {
		text-align: center;
	}
	.p-16 {
		padding: 4rem;
	}
	.pt-20 {
		padding-top: 5rem;
	}
	.mt-20 {
		margin-top: 5rem;
	}
	.py-12 {
		padding-top: 3rem;
		padding-bottom: 3rem;
	}
	.border-t {
		border-top: 1px solid var(--border);
	}
	.mx-auto {
		margin-left: auto;
		margin-right: auto;
	}
	.px-12 {
		padding-left: 3rem;
		padding-right: 3rem;
	}
	.py-4 {
		padding-top: 1rem;
		padding-bottom: 1rem;
	}
	.cta-buttons {
		display: flex;
		gap: 1rem;
		justify-content: center;
		align-items: center;
		flex-wrap: wrap;
	}
	.cta-buttons .btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}
	@media (max-width: 768px) {
		.cta-buttons {
			flex-direction: column;
		}
		.cta-buttons .btn {
			width: 100%;
			justify-content: center;
		}
	}
</style>

