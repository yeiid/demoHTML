---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import KeyBenefits from "../components/KeyBenefits.astro";
import InteractiveDemo from "../components/InteractiveDemo.astro";
import Features from "../components/Features.astro";
import CloudSync from "../components/CloudSync.astro";
import DownloadSection from "../components/DownloadSection.astro";
import "../styles/global.css";
---

<Layout title="GymTrack v1.1.4 | Gestión de Gimnasios Inteligente — NeuralJira">
	<header class="site-header">
		<a href="#main-content" class="skip-link visually-hidden">Saltar al contenido principal</a>
		<div class="container nav-inner">
			<a href="#" class="brand-logo">
				<span class="brand-dot"></span>
				<span>GymTrack</span>
				<small class="brand-ver" id="brand-version-badge">v1.1.5</small>
			</a>
			<nav aria-label="Principal">
				<ul class="nav-list" role="list">
					<li><a href="#features">Módulos</a></li>
					<li><a href="#demo">Demo Interactiva</a></li>
					<li><a href="#cloud">Cloud Sync</a></li>
					<li><a href="#contacto">Contacto</a></li>
					<li><a href="#download" class="nav-cta">Descargar Gratis ↓</a></li>
				</ul>
			</nav>
		</div>
	</header>

	<main id="main-content" tabindex="-1">
		<Hero />

		<div class="divider"></div>

		<Features />

		<div class="divider"></div>

		<KeyBenefits />

		<div class="divider"></div>

		<InteractiveDemo />

		<div class="divider"></div>

		<CloudSync />

		<div class="divider"></div>

		<DownloadSection />

		<section id="cta" class="container text-center pt-20">
			<div
				class="glass p-16"
				style="background: linear-gradient(180deg, rgba(249,115,22,.05) 0%, transparent 100%);"
			>
				<h2 class="text-5xl font-bold mb-6">
					¿Listo para transformar tu gimnasio?
				</h2>
				<p class="text-xl text-muted mb-10 max-w-2xl mx-auto">
					Descarga el instalador oficial desde nuestro servidor seguro, activa tu prueba gratuita de 7 días al instante y lleva el control total de tu negocio.
				</p>
				<div class="cta-buttons">
					<a
						href="#download"
						class="btn btn-primary px-8 py-4 text-lg"
					>
						<svg
							aria-hidden="true"
							xmlns="http://www.w3.org/2000/svg"
							width="22"
							height="22"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
							<polyline points="7 10 12 15 17 10"></polyline>
							<line x1="12" y1="15" x2="12" y2="3"></line>
						</svg>
						Ir a Descargas
					</a>
					<a
						href="https://wa.me/573058079573?text=Hola%20NeuralJira,%20deseo%20informaci%C3%B3n%20sobre%20la%20licencia%20de%20GymTrack"
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-whatsapp px-8 py-4 text-lg"
					>
						<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
							<path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
						</svg>
						WhatsApp: +57 305 807 9573
					</a>
					<a
						href="mailto:yeifran67@gmail.com?cc=contacto@neuraljira.tech&subject=Informaci%C3%B3n%20Licencia%20GymTrack"
						class="btn glass px-8 py-4 text-lg"
					>
						<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<rect x="2" y="4" width="20" height="16" rx="2"></rect>
							<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
						</svg>
						yeifran67@gmail.com
					</a>
				</div>
			</div>
		</section>
	</main>

	<!-- Footer with complete NeuralJira Contact Info -->
	<footer id="contacto" class="site-footer border-t mt-20">
		<div class="container py-16 footer-grid">
			<div class="footer-col brand-col">
				<div class="brand-logo mb-4">
					<span class="brand-dot"></span>
					<span>GymTrack</span>
					<small class="brand-ver">NeuralJira</small>
				</div>
				<p class="text-muted text-sm leading-relaxed mb-4">
					Desarrollado y respaldado por <strong>NeuralJira</strong>. Plataforma integral de gestión de gimnasios con arquitectura híbrida offline ultrarrápida, punto de venta y validación criptográfica Ed25519.
				</p>
				<span class="font-mono text-xs text-muted">
					Servidor Central: <code>server.neuraljira.tech</code>
				</span>
			</div>

			<div class="footer-col">
				<h4 class="footer-heading">Navegación</h4>
				<ul class="footer-links" role="list">
					<li><a href="#features">Módulos del Sistema</a></li>
					<li><a href="#demo">Demo Interactiva</a></li>
					<li><a href="#cloud">Sincronización Cloud</a></li>
					<li><a href="#download">Centro de Descargas</a></li>
				</ul>
			</div>

			<div class="footer-col">
				<h4 class="footer-heading">Contacto Oficial NeuralJira</h4>
				<ul class="footer-contact-list" role="list">
					<li>
						<a href="https://wa.me/573058079573?text=Hola%20NeuralJira,%20deseo%20informaci%C3%B3n%20sobre%20GymTrack" target="_blank" rel="noopener noreferrer" class="contact-link">
							<span class="contact-icon" style="color: #25D366;">📱</span>
							<span><strong>WhatsApp / Tel:</strong> +57 305 807 9573</span>
						</a>
					</li>
					<li>
						<a href="mailto:yeifran67@gmail.com?subject=GymTrack%20Contacto" class="contact-link">
							<span class="contact-icon">✉️</span>
							<span><strong>Personal:</strong> yeifran67@gmail.com</span>
						</a>
					</li>
					<li>
						<a href="mailto:contacto@neuraljira.tech?subject=GymTrack%20Comercial" class="contact-link">
							<span class="contact-icon">🏢</span>
							<span><strong>Corporativo:</strong> contacto@neuraljira.tech</span>
						</a>
					</li>
					<li>
						<div class="contact-link text-muted text-xs">
							<span class="contact-icon">⏱️</span>
							<span>Atención y Activaciones: Lun - Sáb</span>
						</div>
					</li>
				</ul>
			</div>
		</div>

		<div class="footer-bottom border-t text-center py-6 text-muted text-xs">
			<p>&copy; 2026 GymTrack SaaS · Desarrollado por <strong>NeuralJira</strong>. Todos los derechos reservados.</p>
		</div>
	</footer>

	<!-- Floating WhatsApp Help Button -->
	<a
		href="https://wa.me/573058079573?text=Hola%20NeuralJira,%20deseo%20asesor%C3%ADa%20sobre%20GymTrack"
		target="_blank"
		rel="noopener noreferrer"
		class="floating-whatsapp-btn"
		aria-label="Hablar por WhatsApp con NeuralJira al +57 305 807 9573"
		title="Asistencia y Ventas por WhatsApp"
	>
		<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="currentColor">
			<path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
		</svg>
		<span class="floating-tooltip">¿Dudas? Escríbenos por WhatsApp</span>
	</a>
</Layout>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(11, 15, 26, 0.85);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border);
		padding: 0.85rem 0;
	}
	.skip-link:focus {
		position: fixed !important;
		top: 0.75rem;
		left: 0.75rem;
		z-index: 100;
		background: var(--accent);
		color: var(--ink);
		padding: 0.5rem 1rem;
		border-radius: 6px;
		font-weight: 700;
	}
	.nav-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}
	.brand-logo {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: 800;
		font-size: 1.2rem;
		color: var(--white);
	}
	.brand-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 8px var(--accent);
	}
	.brand-ver {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--electric);
		background: rgba(56, 189, 248, 0.12);
		border: 1px solid rgba(56, 189, 248, 0.3);
		padding: 0.1rem 0.45rem;
		border-radius: 4px;
	}
	.nav-list {
		list-style: none;
		display: flex;
		align-items: center;
		gap: 1.5rem;
		margin: 0;
		padding: 0;
		flex-wrap: wrap;
	}
	.nav-list a {
		color: var(--text);
		font-size: 0.9rem;
		font-weight: 600;
	}
	.nav-list a:hover {
		color: var(--accent);
	}
	.nav-cta {
		background: rgba(249, 115, 22, 0.15);
		color: var(--accent) !important;
		border: 1px solid rgba(249, 115, 22, 0.35);
		padding: 0.4rem 0.95rem;
		border-radius: 6px;
	}
	.nav-cta:hover {
		background: var(--accent);
		color: var(--ink) !important;
	}
	.divider {
		height: 1px;
		background: linear-gradient(
			90deg,
			transparent,
			var(--border),
			transparent
		);
		margin: 3rem 0;
	}
	.text-5xl {
		font-size: 3.5rem;
	}
	.text-center {
		text-align: center;
	}
	.p-16 {
		padding: 4rem;
	}
	.pt-20 {
		padding-top: 5rem;
	}
	.mt-20 {
		margin-top: 5rem;
	}
	.py-12 {
		padding-top: 3rem;
		padding-bottom: 3rem;
	}
	.border-t {
		border-top: 1px solid var(--border);
	}
	.mx-auto {
		margin-left: auto;
		margin-right: auto;
	}
	.px-12 {
		padding-left: 3rem;
		padding-right: 3rem;
	}
	.py-4 {
		padding-top: 1rem;
		padding-bottom: 1rem;
	}
	.cta-buttons {
		display: flex;
		gap: 1rem;
		justify-content: center;
		align-items: center;
		flex-wrap: wrap;
	}
	.cta-buttons .btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}
	@media (max-width: 768px) {
		.cta-buttons {
			flex-direction: column;
		}
		.cta-buttons .btn {
			width: 100%;
			justify-content: center;
		}
	}

	/* WhatsApp CTA button */
	.btn-whatsapp {
		background: #25D366;
		color: #ffffff !important;
		font-weight: 700;
		border: 1px solid #1ebd5a;
		box-shadow: 0 4px 14px rgba(37, 211, 102, 0.3);
		transition: all 0.25s ease;
	}
	.btn-whatsapp:hover {
		background: #20ba59;
		transform: translateY(-2px);
		box-shadow: 0 6px 20px rgba(37, 211, 102, 0.45);
	}

	/* Footer Grid & Links */
	.site-footer {
		background: rgba(8, 11, 20, 0.95);
		border-top: 1px solid var(--border);
	}
	.footer-grid {
		display: grid;
		grid-template-columns: 1.5fr 1fr 1.5fr;
		gap: 3rem;
	}
	.footer-heading {
		font-size: 1rem;
		font-weight: 700;
		color: var(--white);
		margin-bottom: 1.25rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	.footer-links, .footer-contact-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}
	.footer-links a, .contact-link {
		color: var(--text-muted);
		text-decoration: none;
		font-size: 0.9rem;
		transition: color 0.2s;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}
	.footer-links a:hover, .contact-link:hover {
		color: var(--accent);
	}
	.contact-icon {
		font-size: 1.1rem;
		flex-shrink: 0;
	}

	@media (max-width: 900px) {
		.footer-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
	}

	/* Floating WhatsApp Widget */
	.floating-whatsapp-btn {
		position: fixed;
		bottom: 1.75rem;
		right: 1.75rem;
		z-index: 999;
		width: 58px;
		height: 58px;
		background: #25D366;
		color: white;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 6px 24px rgba(37, 211, 102, 0.4);
		transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
		text-decoration: none;
	}
	.floating-whatsapp-btn:hover {
		transform: scale(1.1) translateY(-3px);
		box-shadow: 0 10px 30px rgba(37, 211, 102, 0.6);
	}
	.floating-tooltip {
		position: absolute;
		right: 70px;
		background: rgba(15, 23, 42, 0.95);
		color: white;
		padding: 6px 12px;
		border-radius: 6px;
		font-size: 0.78rem;
		font-weight: 600;
		white-space: nowrap;
		border: 1px solid var(--border);
		pointer-events: none;
		opacity: 0;
		transform: translateX(10px);
		transition: all 0.25s ease;
	}
	.floating-whatsapp-btn:hover .floating-tooltip {
		opacity: 1;
		transform: translateX(0);
	}
	@media (max-width: 640px) {
		.floating-tooltip {
			display: none;
		}
		.floating-whatsapp-btn {
			bottom: 1rem;
			right: 1rem;
			width: 50px;
			height: 50px;
		}
	}
</style>

