---
const SERVER_BASE_URL = "https://server.neuraljira.tech";

const platforms = [
    {
        id: "windows",
        name: "Windows 10 / 11",
        badge: "Instalador Oficial Inteligente (64-bit)",
        filename: "GymTrack-Setup.exe",
        sizeDefault: "6.7 MB",
        downloadUrl: `${SERVER_BASE_URL}/api/download?platform=windows`,
        directUrl: `${SERVER_BASE_URL}/downloads/GymTrack-Setup.exe`,
        description:
            "Descarga el instalador ligero oficial. Al abrirlo, se encarga automáticamente de descargar la última versión del software GymTrack desde nuestro servidor, verificar su integridad SHA-256 y crear tus accesos directos.",
        requirements: "Windows 10 o Windows 11 (x64) • Sin dependencias externas",
    },
    {
        id: "linux",
        name: "Linux Desktop",
        badge: "Instalador Oficial Inteligente (x86_64)",
        filename: "gymtrack-installer",
        sizeDefault: "6.5 MB",
        downloadUrl: `${SERVER_BASE_URL}/api/download?platform=linux`,
        directUrl: `${SERVER_BASE_URL}/downloads/gymtrack-installer`,
        description:
            "Asistente gráfico nativo para Linux. Se conecta de forma segura al servidor central para descargar e instalar el software completo de GymTrack, validando la firma SHA-256 y configurando el acceso en tu menú de aplicaciones.",
        requirements: "Ubuntu 20.04+, Debian 11+, Fedora o derivados (x86_64)",
    },
];
---

<section id="download" class="container py-20" data-server-url={SERVER_BASE_URL}>
    <div class="download-wrapper">
        <div class="download-header text-center mb-12">
            <span class="badge mb-4">Prueba Gratuita de 7 Días · Instalador Oficial</span>
            <h2 class="text-5xl font-bold mb-6">
                Descarga <span class="gradient-text">GymTrack</span> desde el Servidor Oficial
            </h2>
            <p class="text-xl text-muted max-w-2xl mx-auto">
                Descarga nuestro <strong>instalador ligero (~6.5 MB)</strong> desde <code>server.neuraljira.tech</code>. El instalador se encarga automáticamente de descargar el software completo, verificar su firma <strong>SHA-256</strong> y dejar listo tu gimnasio.
            </p>
        </div>

        <!-- Unified Server Status Bar -->
        <div class="server-status-bar glass mb-8" role="status" aria-live="polite">
            <div class="status-left">
                <span class="status-dot" id="server-status-dot"></span>
                <span class="font-mono text-xs" id="server-status-text">
                    Servidor Oficial: <strong>server.neuraljira.tech</strong> · Canal Estable
                </span>
            </div>
            <div class="status-right">
                <span class="version-pill" id="live-version-badge">v1.1.4</span>
                <span class="security-pill">
                    <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                    TLS + SHA-256 + Ed25519
                </span>
            </div>
        </div>

        <div class="download-hub glass">
            <!-- OS Selector Tabs -->
            <div class="os-tabs-header">
                <div class="os-tabs-label">
                    <span class="font-mono text-xs text-muted">// SELECCIONA TU SISTEMA OPERATIVO</span>
                    <span class="os-detected-badge" id="os-detected-badge">Detectando sistema...</span>
                </div>
                <div class="os-tablist" role="tablist" aria-label="Plataformas de descarga disponibles">
                    <button
                        type="button"
                        role="tab"
                        id="tab-btn-windows"
                        aria-selected="true"
                        aria-controls="panel-windows"
                        class="os-tab active"
                        data-os-tab="windows"
                    >
                        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.9-1.801"/>
                        </svg>
                        <span>Windows 10/11</span>
                    </button>
                    <button
                        type="button"
                        role="tab"
                        id="tab-btn-linux"
                        aria-selected="false"
                        aria-controls="panel-linux"
                        tabindex="-1"
                        class="os-tab"
                        data-os-tab="linux"
                    >
                        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                            <line x1="8" y1="21" x2="16" y2="21"></line>
                            <line x1="12" y1="17" x2="12" y2="21"></line>
                        </svg>
                        <span>Linux (64-bit)</span>
                    </button>
                </div>
            </div>

            <div class="hub-grid">
                <!-- Left Column: Active Platform Download Panel -->
                <div class="platform-panels">
                    <!-- WINDOWS PANEL -->
                    <div
                        id="panel-windows"
                        role="tabpanel"
                        aria-labelledby="tab-btn-windows"
                        class="os-panel active"
                        data-os-panel="windows"
                    >
                        <div class="panel-badge-row">
                            <span class="platform-tag">{platforms[0].badge}</span>
                            <span class="file-meta font-mono" id="win-file-meta">
                                {platforms[0].filename} • {platforms[0].sizeDefault}
                            </span>
                        </div>
                        <h3 class="text-3xl font-bold mb-3">Instalador GymTrack para Windows</h3>
                        <p class="text-muted mb-6">{platforms[0].description}</p>

                        <div class="download-actions-group">
                            <a
                                id="win-primary-download"
                                href={platforms[0].downloadUrl}
                                rel="noopener noreferrer"
                                class="btn btn-primary btn-download-main"
                            >
                                <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                    <polyline points="7 10 12 15 17 10"></polyline>
                                    <line x1="12" y1="15" x2="12" y2="3"></line>
                                </svg>
                                <div class="btn-text-block">
                                    <span class="btn-title">Descargar Instalador Windows (GymTrack-Setup.exe)</span>
                                    <span class="btn-sub" id="win-btn-sub">Instalador Ligero ({platforms[0].sizeDefault}) • Descarga e instala el software automáticamente</span>
                                </div>
                            </a>
                        </div>

                        <div class="checksum-box mt-6">
                            <div class="checksum-header">
                                <span class="font-mono text-xs">🔒 CHECKSUM SHA-256 DEL INSTALADOR (WINDOWS)</span>
                                <button type="button" class="copy-sha-btn" data-copy-target="win-sha-value" aria-label="Copiar hash SHA-256 del instalador de Windows">
                                    Copiar Hash
                                </button>
                            </div>
                            <code id="win-sha-value" class="checksum-code">
                                Verificando firma con server.neuraljira.tech...
                            </code>
                        </div>

                        <p class="download-note">
                            ✓ {platforms[0].requirements} • Incluye actualizaciones automáticas OTA
                        </p>
                    </div>

                    <!-- LINUX PANEL -->
                    <div
                        id="panel-linux"
                        role="tabpanel"
                        aria-labelledby="tab-btn-linux"
                        class="os-panel"
                        data-os-panel="linux"
                        hidden
                    >
                        <div class="panel-badge-row">
                            <span class="platform-tag">{platforms[1].badge}</span>
                            <span class="file-meta font-mono" id="linux-file-meta">
                                {platforms[1].filename} • {platforms[1].sizeDefault}
                            </span>
                        </div>
                        <h3 class="text-3xl font-bold mb-3">Instalador GymTrack para Linux</h3>
                        <p class="text-muted mb-6">{platforms[1].description}</p>

                        <div class="download-actions-group">
                            <a
                                id="linux-primary-download"
                                href={platforms[1].downloadUrl}
                                rel="noopener noreferrer"
                                class="btn btn-primary btn-download-main"
                            >
                                <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                    <polyline points="7 10 12 15 17 10"></polyline>
                                    <line x1="12" y1="15" x2="12" y2="3"></line>
                                </svg>
                                <div class="btn-text-block">
                                    <span class="btn-title">Descargar Instalador Linux (gymtrack-installer)</span>
                                    <span class="btn-sub" id="linux-btn-sub">Asistente GUI ({platforms[1].sizeDefault}) • Descarga e instala el software automáticamente</span>
                                </div>
                            </a>
                        </div>

                        <div class="checksum-box mt-6">
                            <div class="checksum-header">
                                <span class="font-mono text-xs">🔒 CHECKSUM SHA-256 DEL INSTALADOR (LINUX)</span>
                                <button type="button" class="copy-sha-btn" data-copy-target="linux-sha-value" aria-label="Copiar hash SHA-256 del instalador de Linux">
                                    Copiar Hash
                                </button>
                            </div>
                            <code id="linux-sha-value" class="checksum-code">
                                Verificando firma con server.neuraljira.tech...
                            </code>
                        </div>

                        <p class="download-note">
                            ✓ {platforms[1].requirements} • Crea acceso directo en tu menú de aplicaciones
                        </p>
                    </div>
                </div>

                <!-- Right Column: Grouped Installer Links & How the Installer Works -->
                <div class="grouped-links-sidebar">
                    <div class="grouped-box">
                        <h4 class="grouped-title">
                            <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
                            </svg>
                            Instaladores Oficiales Agrupados
                        </h4>
                        <p class="text-xs text-muted mb-4">
                            Enlaces directos al instalador oficial en <code>server.neuraljira.tech</code> con protección <code>nosniff</code> y validación SHA-256:
                        </p>

                        <ul class="grouped-download-list" role="list">
                            <li>
                                <a id="group-link-win" href={platforms[0].downloadUrl} rel="noopener noreferrer" class="grouped-link-item">
                                    <span class="grouped-os-icon">🪟</span>
                                    <div class="grouped-link-info">
                                        <strong>GymTrack-Setup.exe (Windows)</strong>
                                        <small id="group-meta-win">Instalador Oficial • 6.7 MB • Windows 10/11</small>
                                    </div>
                                    <span class="grouped-dl-badge">HTTPS ↓</span>
                                </a>
                            </li>
                            <li>
                                <a id="group-link-linux-inst" href={platforms[1].downloadUrl} rel="noopener noreferrer" class="grouped-link-item">
                                    <span class="grouped-os-icon">🐧</span>
                                    <div class="grouped-link-info">
                                        <strong>gymtrack-installer (Linux)</strong>
                                        <small id="group-meta-linux">Instalador Oficial GUI • 6.5 MB • x86_64</small>
                                    </div>
                                    <span class="grouped-dl-badge">HTTPS ↓</span>
                                </a>
                            </li>
                        </ul>

                        <div class="release-notes-mini mt-4">
                            <div class="font-mono text-xs text-accent mb-1">// ¿CÓMO FUNCIONA EL INSTALADOR?</div>
                            <p id="live-release-notes" class="text-xs text-muted">
                                1. Descargas el instalador ligero (~6.5 MB). 2. Al abrirlo, consulta <code>/api/version</code>, descarga el paquete completo de GymTrack con verificación SHA-256 y crea tus accesos directos.
                            </p>
                        </div>
                    </div>

                    <div class="included-box mt-4">
                        <h4 class="text-sm font-bold mb-3">Lo que hace el instalador por ti:</h4>
                        <ul class="features-checklist" role="list">
                            <li>
                                <span class="check-mark" aria-hidden="true">1</span>
                                <span>Descarga el software oficial desde <code>server.neuraljira.tech</code></span>
                            </li>
                            <li>
                                <span class="check-mark" aria-hidden="true">2</span>
                                <span>Verifica la integridad criptográfica SHA-256 del paquete</span>
                            </li>
                            <li>
                                <span class="check-mark" aria-hidden="true">3</span>
                                <span>Crea accesos directos en Escritorio y Menú de Inicio</span>
                            </li>
                            <li>
                                <span class="check-mark" aria-hidden="true">4</span>
                                <span>Gestiona futuras actualizaciones OTA sin perder tu base de datos</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Security & Trust Pillars -->
        <div class="info-cards">
            <div class="info-card glass">
                <div class="info-icon" aria-hidden="true">📦</div>
                <h3>1. Instalador Ligero (~6.5 MB)</h3>
                <p>Descargas únicamente el asistente oficial nativo en Go desde nuestro servidor seguro por HTTPS, sin archivos pesados ni dependencias externas.</p>
            </div>
            <div class="info-card glass">
                <div class="info-icon" aria-hidden="true">🛡️</div>
                <h3>2. Descarga y Validación Automática</h3>
                <p>El instalador descarga automáticamente el núcleo completo de GymTrack y comprueba su firma SHA-256 antes de instalarlo en tu equipo.</p>
            </div>
            <div class="info-card glass">
                <div class="info-icon" aria-hidden="true">🔄</div>
                <h3>3. Actualizaciones OTA Inteligentes</h3>
                <p>El instalador permanece integrado para actualizar el software con un clic cuando lancemos mejoras, manteniendo intacta tu base de datos SQLite local.</p>
            </div>
        </div>

        <!-- System Requirements -->
        <div class="system-requirements glass mt-12">
            <h3 class="text-2xl font-bold mb-6">Requisitos del Sistema</h3>
            <div class="requirements-grid">
                <div class="requirement">
                    <strong>Sistemas Operativos:</strong>
                    <span>Windows 10/11 (64-bit) o Linux (Ubuntu 20.04+, Debian, Fedora 64-bit)</span>
                </div>
                <div class="requirement">
                    <strong>Procesador:</strong>
                    <span>Intel Core i3 / AMD Ryzen 3 o equivalente (x86_64)</span>
                </div>
                <div class="requirement">
                    <strong>Memoria RAM:</strong>
                    <span>4 GB mínimo (8 GB recomendado)</span>
                </div>
                <div class="requirement">
                    <strong>Espacio en Disco:</strong>
                    <span>200 MB disponibles para el software instalado y respaldos locales</span>
                </div>
                <div class="requirement">
                    <strong>Modo Offline / Red:</strong>
                    <span>Conexión durante la instalación y activación • Operación diaria 100% offline</span>
                </div>
                <div class="requirement">
                    <strong>Pantalla:</strong>
                    <span>Resolución mínima 1366×768 (1920×1080 recomendado)</span>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    // OS Tab switching + Keyboard navigation (ArrowLeft / ArrowRight)
    const osTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-os-tab]'));
    const osPanels = Array.from(document.querySelectorAll<HTMLElement>('[data-os-panel]'));
    const detectedBadge = document.getElementById('os-detected-badge');

    function selectPlatformTab(osId: string, moveFocus = false) {
        osTabs.forEach((tab) => {
            const isMatch = tab.dataset.osTab === osId;
            tab.classList.toggle('active', isMatch);
            tab.setAttribute('aria-selected', isMatch ? 'true' : 'false');
            tab.setAttribute('tabindex', isMatch ? '0' : '-1');
            if (isMatch && moveFocus) {
                tab.focus();
            }
        });

        osPanels.forEach((panel) => {
            const isMatch = panel.dataset.osPanel === osId;
            panel.classList.toggle('active', isMatch);
            panel.hidden = !isMatch;
        });
    }

    osTabs.forEach((tab, idx) => {
        tab.addEventListener('click', () => {
            if (tab.dataset.osTab) {
                selectPlatformTab(tab.dataset.osTab, false);
            }
        });

        tab.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
                e.preventDefault();
                const nextIdx = e.key === 'ArrowRight'
                    ? (idx + 1) % osTabs.length
                    : (idx - 1 + osTabs.length) % osTabs.length;
                const nextOs = osTabs[nextIdx].dataset.osTab;
                if (nextOs) selectPlatformTab(nextOs, true);
            }
        });
    });

    // Auto-detect visitor OS
    const ua = navigator.userAgent.toLowerCase();
    const isLinux = ua.includes('linux') && !ua.includes('android');
    if (isLinux) {
        selectPlatformTab('linux', false);
        if (detectedBadge) detectedBadge.textContent = '🐧 Linux detectado automáticamente';
    } else if (ua.includes('win')) {
        selectPlatformTab('windows', false);
        if (detectedBadge) detectedBadge.textContent = '🪟 Windows detectado automáticamente';
    } else {
        if (detectedBadge) detectedBadge.textContent = 'Disponible para Windows y Linux';
    }

    // Format bytes helper
    function formatMB(bytes?: number): string {
        if (!bytes || bytes <= 0) return '';
        return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
    }

    // Validate URL strictly belongs to the trusted release server origin
    function isTrustedDownloadUrl(rawUrl: string, trustedBase: string): boolean {
        try {
            const parsed = new URL(rawUrl, trustedBase);
            const trusted = new URL(trustedBase);
            return parsed.protocol === 'https:' && parsed.hostname === trusted.hostname;
        } catch {
            return false;
        }
    }

    // Fetch live version, installer sizes, and installer SHA-256 hashes from server.neuraljira.tech
    async function syncWithReleaseServer() {
        const section = document.getElementById('download');
        const serverBase = section?.getAttribute('data-server-url') || 'https://server.neuraljira.tech';
        const statusDot = document.getElementById('server-status-dot');
        const statusText = document.getElementById('server-status-text');
        const versionBadge = document.getElementById('live-version-badge');
        const releaseNotesEl = document.getElementById('live-release-notes');

        try {
            const resp = await fetch(`${serverBase}/api/version`, {
                method: 'GET',
                headers: { Accept: 'application/json' },
            });
            if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
            const data = await resp.json();

            if (statusDot) statusDot.classList.add('online');
            if (statusText) {
                statusText.textContent = `Conectado a server.neuraljira.tech · Instalador Oficial Verificado`;
            }

            const platforms = data.platforms || {};
            const winInfo = platforms.windows;
            const linuxInfo = platforms.linux;

            if (versionBadge) {
                if (winInfo?.version && linuxInfo?.version && winInfo.version !== linuxInfo.version) {
                    versionBadge.textContent = `Win: v${winInfo.version} · Linux: v${linuxInfo.version}`;
                } else if (data.version) {
                    versionBadge.textContent = `v${String(data.version).replace(/^v/, '')}`;
                }
            }
            const brandBadge = document.getElementById('brand-version-badge');
            if (brandBadge && data.version) {
                brandBadge.textContent = `v${String(data.version).replace(/^v/, '')}`;
            }
            if (data.release_notes && releaseNotesEl) {
                releaseNotesEl.textContent = String(data.release_notes);
            }

            // Update Windows Installer metadata safely
            const winShaEl = document.getElementById('win-sha-value');
            if (winInfo) {
                const winInstallerUrl = winInfo.installer_url || `${serverBase}/api/download?platform=windows`;
                const winPrimary = document.getElementById('win-primary-download') as HTMLAnchorElement | null;
                const groupWin = document.getElementById('group-link-win') as HTMLAnchorElement | null;

                if (winPrimary && isTrustedDownloadUrl(winInstallerUrl, serverBase)) {
                    winPrimary.href = winInstallerUrl;
                }
                if (groupWin && isTrustedDownloadUrl(winInstallerUrl, serverBase)) {
                    groupWin.href = winInstallerUrl;
                }

                const instSizeStr = formatMB(winInfo.installer_size_bytes) || '6.7 MB';
                const appSizeStr = formatMB(winInfo.size_bytes);
                const verStr = winInfo.version || data.version || '1.1.4';
                const instName = winInfo.installer_filename || 'GymTrack-Setup.exe';
                const winMeta = document.getElementById('win-file-meta');
                const winSub = document.getElementById('win-btn-sub');
                const groupMetaWin = document.getElementById('group-meta-win');

                if (winMeta) winMeta.textContent = `${instName} (${instSizeStr}) • Instala GymTrack v${verStr}`;
                if (winSub) {
                    winSub.textContent = appSizeStr
                        ? `Instalador Ligero (${instSizeStr}) • Descarga GymTrack v${verStr} (${appSizeStr})`
                        : `Instalador Ligero (${instSizeStr}) • Descarga e instala GymTrack v${verStr} automáticamente`;
                }
                if (groupMetaWin) groupMetaWin.textContent = `Instalador v${verStr} • ${instSizeStr} • Windows 10/11`;

                const winHash = winInfo.installer_sha256 || winInfo.sha256;
                if (winShaEl) {
                    winShaEl.textContent = winHash
                        ? String(winHash)
                        : 'Verificado en el servidor (cabecera X-Checksum-SHA256 activa)';
                }
            } else if (winShaEl) {
                winShaEl.textContent = data.sha256
                    ? String(data.sha256)
                    : 'Verificado por el servidor en la descarga (X-Checksum-SHA256)';
            }

            // Update Linux Installer metadata safely
            const linuxShaEl = document.getElementById('linux-sha-value');
            if (linuxInfo) {
                const linuxInstallerUrl = linuxInfo.installer_url || `${serverBase}/api/download?platform=linux`;
                const linuxPrimary = document.getElementById('linux-primary-download') as HTMLAnchorElement | null;
                const groupLinux = document.getElementById('group-link-linux-inst') as HTMLAnchorElement | null;

                if (linuxPrimary && isTrustedDownloadUrl(linuxInstallerUrl, serverBase)) {
                    linuxPrimary.href = linuxInstallerUrl;
                }
                if (groupLinux && isTrustedDownloadUrl(linuxInstallerUrl, serverBase)) {
                    groupLinux.href = linuxInstallerUrl;
                }

                const instSizeStr = formatMB(linuxInfo.installer_size_bytes) || '6.5 MB';
                const appSizeStr = formatMB(linuxInfo.size_bytes);
                const verStr = linuxInfo.version || data.version || '1.1.4';
                const instName = linuxInfo.installer_filename || 'gymtrack-installer';
                const linuxMeta = document.getElementById('linux-file-meta');
                const linuxSub = document.getElementById('linux-btn-sub');
                const groupMetaLinux = document.getElementById('group-meta-linux');

                if (linuxMeta) linuxMeta.textContent = `${instName} (${instSizeStr}) • Instala GymTrack v${verStr}`;
                if (linuxSub) {
                    linuxSub.textContent = appSizeStr
                        ? `Asistente GUI (${instSizeStr}) • Descarga GymTrack v${verStr} (${appSizeStr})`
                        : `Asistente GUI (${instSizeStr}) • Descarga e instala GymTrack v${verStr} automáticamente`;
                }
                if (groupMetaLinux) groupMetaLinux.textContent = `Instalador GUI v${verStr} • ${instSizeStr} • x86_64`;

                const linuxHash = linuxInfo.installer_sha256 || linuxInfo.sha256;
                if (linuxShaEl) {
                    linuxShaEl.textContent = linuxHash
                        ? String(linuxHash)
                        : 'Verificado en el servidor (cabecera X-Checksum-SHA256 activa)';
                }
            } else if (linuxShaEl) {
                linuxShaEl.textContent = 'Verificado por el servidor en la descarga (X-Checksum-SHA256)';
            }
        } catch {
            // Graceful fallback when offline or blocked by CORS
            const winShaEl = document.getElementById('win-sha-value');
            const linuxShaEl = document.getElementById('linux-sha-value');
            if (winShaEl) winShaEl.textContent = 'Verificación automática vía cabecera HTTPS X-Checksum-SHA256';
            if (linuxShaEl) linuxShaEl.textContent = 'Verificación automática vía cabecera HTTPS X-Checksum-SHA256';
        }
    }

    // Copy SHA-256 button handlers
    document.querySelectorAll<HTMLButtonElement>('.copy-sha-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
            const targetId = btn.getAttribute('data-copy-target');
            const codeEl = targetId ? document.getElementById(targetId) : null;
            const text = codeEl?.textContent?.trim();
            if (!text) return;
            try {
                await navigator.clipboard.writeText(text);
                const prev = btn.textContent;
                btn.textContent = '¡Copiado!';
                setTimeout(() => {
                    btn.textContent = prev;
                }, 1800);
            } catch {
                // Clipboard unavailable
            }
        });
    });

    syncWithReleaseServer();
</script>

