---
import UserDemo from "./UserDemo.astro";
import FinanceDemo from "./FinanceDemo.astro";
import SalesDemo from "./SalesDemo.astro";
import ProductDemo from "./ProductDemo.astro";
import ConfigDemo from "./ConfigDemo.astro";

const tabs = [
    { id: "users", label: "Usuarios y Asistencia", icon: "👤" },
    { id: "finance", label: "Finanzas", icon: "💰" },
    { id: "sales", label: "Ventas / POS", icon: "🛒" },
    { id: "inventory", label: "Inventario", icon: "📦" },
    { id: "config", label: "Sistema y Licencia", icon: "🔐" },
];
---

<section id="demo" class="container py-12">
    <div class="text-center mb-10">
        <span class="badge mb-4">Simulador Interactivo · v1.1.4</span>
        <h2 class="text-4xl font-bold mb-4">
            Explora la <span class="gradient-text">Experiencia GymTrack</span>
        </h2>
        <p class="text-muted max-w-2xl mx-auto">
            Navega por los 5 módulos principales de la aplicación de escritorio: desde control de membresías y POS hasta licenciamiento criptográfico y actualizaciones OTA.
        </p>
    </div>

    <div class="demo-wrapper glass">
        <div class="demo-sidebar" role="tablist" aria-label="Módulos del sistema GymTrack">
            {
                tabs.map((tab, idx) => (
                    <button
                        type="button"
                        role="tab"
                        id={`demo-tab-${tab.id}`}
                        aria-selected={idx === 0 ? "true" : "false"}
                        aria-controls={tab.id}
                        tabindex={idx === 0 ? "0" : "-1"}
                        class={`tab-btn ${idx === 0 ? "active" : ""}`}
                        data-tab={tab.id}
                    >
                        <span class="tab-icon" aria-hidden="true">{tab.icon}</span>
                        <span class="tab-label">{tab.label}</span>
                    </button>
                ))
            }
        </div>

        <div class="demo-content">
            <div id="users" role="tabpanel" aria-labelledby="demo-tab-users" class="tab-content active">
                <UserDemo />
            </div>
            <div id="finance" role="tabpanel" aria-labelledby="demo-tab-finance" class="tab-content" hidden>
                <FinanceDemo />
            </div>
            <div id="sales" role="tabpanel" aria-labelledby="demo-tab-sales" class="tab-content" hidden>
                <SalesDemo />
            </div>
            <div id="inventory" role="tabpanel" aria-labelledby="demo-tab-inventory" class="tab-content" hidden>
                <ProductDemo />
            </div>
            <div id="config" role="tabpanel" aria-labelledby="demo-tab-config" class="tab-content" hidden>
                <ConfigDemo />
            </div>
        </div>
    </div>
</section>

<script>
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>(".demo-sidebar .tab-btn"));
    const contents = Array.from(document.querySelectorAll<HTMLElement>(".demo-content .tab-content"));

    function activateDemoTab(tabId: string, focusTab = false) {
        buttons.forEach((b) => {
            const isActive = b.getAttribute("data-tab") === tabId;
            b.classList.toggle("active", isActive);
            b.setAttribute("aria-selected", isActive ? "true" : "false");
            b.setAttribute("tabindex", isActive ? "0" : "-1");
            if (isActive && focusTab) {
                b.focus();
            }
        });

        contents.forEach((content) => {
            const isActive = content.id === tabId;
            content.classList.toggle("active", isActive);
            content.hidden = !isActive;
        });
    }

    buttons.forEach((btn, idx) => {
        btn.addEventListener("click", () => {
            const tabId = btn.getAttribute("data-tab");
            if (tabId) activateDemoTab(tabId, false);
        });

        btn.addEventListener("keydown", (e) => {
            if (["ArrowDown", "ArrowRight", "ArrowUp", "ArrowLeft"].includes(e.key)) {
                e.preventDefault();
                const forward = e.key === "ArrowDown" || e.key === "ArrowRight";
                const nextIdx = forward
                    ? (idx + 1) % buttons.length
                    : (idx - 1 + buttons.length) % buttons.length;
                const nextId = buttons[nextIdx].getAttribute("data-tab");
                if (nextId) activateDemoTab(nextId, true);
            }
        });
    });
</script>

<style>
    .demo-wrapper {
        display: flex;
        min-height: 600px;
        overflow: hidden;
        border: 1px solid var(--border);
    }

    .demo-sidebar {
        width: 240px;
        background: rgba(255, 255, 255, 0.02);
        border-right: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        padding: 1rem;
        gap: 0.5rem;
        flex-shrink: 0;
    }

    .tab-btn {
        background: transparent;
        border: none;
        color: var(--text);
        opacity: 0.75;
        padding: 0.95rem 1rem;
        text-align: left;
        border-radius: 0.75rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        transition: all 0.25s ease;
        font-family: inherit;
        font-weight: 600;
        font-size: 0.92rem;
    }

    .tab-btn:hover {
        background: rgba(255, 255, 255, 0.05);
        opacity: 1;
        color: var(--white);
    }

    .tab-btn.active {
        background: var(--accent);
        color: var(--ink);
        opacity: 1;
        box-shadow: 0 4px 15px rgba(249, 115, 22, 0.3);
    }

    .tab-btn:focus-visible {
        outline: 3px solid var(--electric);
        outline-offset: 2px;
    }

    .demo-content {
        flex: 1;
        padding: 2rem;
        position: relative;
        overflow-y: auto;
        max-height: 800px;
    }

    .tab-content {
        display: none;
        opacity: 0;
        transform: translateY(10px);
        transition: all 0.4s ease;
    }

    .tab-content.active {
        display: block;
        opacity: 1;
        transform: translateY(0);
    }

    /* Adjust demo components inside the tab */
    :global(.tab-content section) {
        padding: 0 !important;
        max-width: 100% !important;
    }

    :global(.tab-content .text-center.mb-16) {
        display: none !important;
    }

    @media (max-width: 768px) {
        .demo-wrapper {
            flex-direction: column;
        }
        .demo-sidebar {
            width: 100%;
            flex-direction: row;
            overflow-x: auto;
            border-right: none;
            border-bottom: 1px solid var(--border);
        }
        .tab-label {
            font-size: 0.8rem;
            white-space: nowrap;
        }
    }
</style>

