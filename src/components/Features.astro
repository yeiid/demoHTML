---
const features = [
  {
    title: "Gestión de Usuarios y Asistencia",
    description: "Registro de miembros, control de acceso diario con calendario y alertas de vencimiento de membresías.",
    icon: "👤",
  },
  {
    title: "Finanzas Historizadas",
    description: "Ingresos, egresos, balance neto y reportes exportables a PDF/Excel para salud económica óptima.",
    icon: "💰",
  },
  {
    title: "Punto de Venta (POS)",
    description: "Vende suplementos, bebidas y planes con cálculo automático de impuestos y recibos al instante.",
    icon: "🛒",
  },
  {
    title: "Inventario Inteligente",
    description: "Control de stock en tiempo real, alertas de bajo inventario y categorización de productos.",
    icon: "📦",
  },
  {
    title: "Sincronización Cloud + Autosanación",
    description: "Base de datos SQLite local ultrarrápida con módulo db_repair automático y respaldo en la nube.",
    icon: "☁️",
  },
  {
    title: "Licencias Ed25519 & Updates OTA",
    description: "Validación criptográfica offline y actualizaciones automáticas verificadas con SHA-256 desde el servidor.",
    icon: "🔐",
  },
];
---

<section id="features" class="container">
  <div class="text-center mb-12">
    <h2 class="text-4xl font-bold mb-4">Funcionalidades <span class="gradient-text">Premium</span></h2>
    <p class="text-muted max-w-2xl mx-auto">Todo lo que necesitas para llevar tu gimnasio al siguiente nivel con una arquitectura híbrida local + cloud.</p>
  </div>
  
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mt-12">
    {features.map(feature => (
      <div class="glass p-8 hover:transform hover:-translate-y-2 transition-all duration-300">
        <div class="text-4xl mb-6" aria-hidden="true">{feature.icon}</div>
        <h3 class="text-xl font-semibold mb-3">{feature.title}</h3>
        <p class="text-muted">{feature.description}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .text-center { text-align: center; }
  .mb-12 { margin-bottom: 3rem; }
  .mb-4 { margin-bottom: 1rem; }
  .mb-3 { margin-bottom: 0.75rem; }
  .mt-12 { margin-top: 3rem; }
  .text-4xl { font-size: 2.25rem; }
  .text-xl { font-size: 1.25rem; }
  .max-w-2xl { max-width: 42rem; }
  .mx-auto { margin-left: auto; margin-right: auto; }
  .grid { display: grid; }
  .gap-8 { gap: 2rem; }
  
  @media (min-width: 768px) {
    .md\:grid-cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  
  @media (min-width: 1024px) {
    .lg\:grid-cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>

